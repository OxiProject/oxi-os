# Oxi OS desktop package manifest (Debian Sid).
# Used by scripts/build-iso.sh to seed the live environment so the
# installer payload matches what Anaconda lays down via kickstart.
#
# Sections: [base] [desktop] [installer] [boot] [firmware] — keep the
# package lists in installer/kickstart/oxios-xfs.ks in sync with this file.

[base]
sudo
bash-completion
nano
vim
curl
wget
ca-certificates
os-prober
pciutils

[desktop]
gnome
gnome-shell
gnome-session
gnome-control-center
gnome-terminal
nautilus
gdm3
gnome-software
gnome-text-editor
gnome-calculator
gnome-system-monitor
gnome-disk-utility
gnome-tweaks
gnome-shell-extensions
baobab
file-roller
eog
evince
yelp
network-manager
wireless-regdb
wpasupplicant
pipewire
wireplumber
pipewire-audio
pipewire-pulse
flatpak
libreoffice
libreoffice-gtk3

[installer]
parted
dosfstools
xfsprogs
cryptsetup
debootstrap
squashfs-tools
xorriso
python3-gi
gir1.2-gtk-4.0
gir1.2-adw-1
libadwaita-1-0
python3-parted
network-manager

[boot]
linux-image-amd64
linux-headers-amd64
grub-efi-amd64
grub-pc-bin
shim-signed
plymouth
plymouth-themes
plymouth-label

[firmware]
firmware-linux
firmware-linux-free
firmware-linux-nonfree
firmware-intel-sound
firmware-sof-signed
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-misc-nonfree
amd64-microcode
intel-microcode
