#!/bin/sh
set -e

replace_branding() {
  file="$1"

  [ -f "$file" ] || return 0

  sed -i \
    -e 's/Debian Live/Oxi OS Live/g' \
    -e 's/Debian GNU\/Linux/Oxi OS/g' \
    -e 's/Debian/Oxi OS/g' \
    -e 's/debian/Oxi OS/g' \
    "$file"
}

for file in \
  binary/isolinux/*.cfg \
  binary/boot/grub/*.cfg \
  binary/EFI/boot/*.cfg
do
  replace_branding "$file"
done

if [ -f binary/isolinux/menu.cfg ]; then
  sed -i \
    -e '1i MENU TITLE Oxi OS' \
    -e '/^MENU BACKGROUND/d' \
    -e '/^MENU COLOR screen/d' \
    -e '/^MENU COLOR border/d' \
    -e '/^MENU COLOR title/d' \
    -e '/^MENU COLOR sel/d' \
    -e '/^MENU COLOR unsel/d' \
    -e '$a MENU COLOR screen 0 #ffffffff #00000000 std' \
    -e '$a MENU COLOR border 0 #ff000000 #00000000 std' \
    -e '$a MENU COLOR title 0 #ffffffff #00000000 std' \
    -e '$a MENU COLOR sel 0 #ff000000 #ffffffff std' \
    -e '$a MENU COLOR unsel 0 #ffffffff #00000000 std' \
    binary/isolinux/menu.cfg
fi

if [ -f binary/boot/grub/grub.cfg ]; then
  sed -i \
    -e '1i set menu_color_normal=white/black' \
    -e '1i set menu_color_highlight=black/white' \
    -e '1i set color_normal=white/black' \
    binary/boot/grub/grub.cfg
fi

if [ -f binary/boot/grub/grub.cfg ]; then
  cat >> binary/boot/grub/grub.cfg <<'EOF'

# OxiOS Live GRUB Theme
set theme=/boot/grub/themes/oxios/theme.txt
export theme
EOF

  mkdir -p binary/boot/grub/themes/oxios
  if [ -f /usr/share/pixmaps/oxios-logo.png ]; then
    cp /usr/share/pixmaps/oxios-logo.png binary/boot/grub/themes/oxios/logo.png 2>/dev/null || true
  fi
  
  cat > binary/boot/grub/themes/oxios/theme.txt <<'EOF'
# OxiOS Live GRUB Theme

title-text: "Oxi OS Live"
title-font: "DejaVu Sans Bold 16"
title-color: "#ffffff"
title-align: "center"

desktop-image: "logo.png"
desktop-color: "#000000"

terminal-box: "terminal_box_*.png"
terminal-font: "DejaVu Sans Mono 10"
terminal-border: 10
terminal-left: 10%
terminal-top: 35%
terminal-width: 80%
terminal-height: 40%

+ boot_menu {
    left = 10%
    top = 35%
    width = 80%
    height = 40%
    item_font = "DejaVu Sans 12"
    item_color = "#ffffff"
    selected_item_color = "#18a999"
    item_height = 24
    item_padding = 10
    item_spacing = 4
    scrollbar = true
    scrollbar_width = 8
    scrollbar_color = "#333333"
    scrollbar_thumb_color = "#18a999"
}

+ progress_bar {
    id = "__timeout__"
    left = 10%
    top = 85%
    width = 80%
    height = 8
    bg_color = "#333333"
    fg_color = "#18a999"
    border_color = "#000000"
    text = "@TIMEOUT_NOTIFICATION_LONG@"
    font = "DejaVu Sans 10"
    text_color = "#ffffff"
}
EOF
fi
