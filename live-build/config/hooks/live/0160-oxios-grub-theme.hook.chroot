#!/bin/bash
set -e

echo "Configuring GRUB theme..."

GRUB_THEME_DIR="/usr/share/grub/themes/oxios"
LOGO_SOURCE="/usr/share/pixmaps/oxios-logo.png"

mkdir -p "$GRUB_THEME_DIR"

if [ -f "$LOGO_SOURCE" ] && command -v convert >/dev/null 2>&1; then
    convert "$LOGO_SOURCE" -resize 256x256 "$GRUB_THEME_DIR/logo.png" 2>/dev/null || \
    cp -f "$LOGO_SOURCE" "$GRUB_THEME_DIR/logo.png"
fi

cat > "$GRUB_THEME_DIR/theme.txt" <<'EOF'
# OxiOS GRUB Theme

title-text: "Oxi OS"
title-font: "DejaVu Sans Bold 16"
title-color: "#ffffff"
title-align: "center"

desktop-image: "logo.png"
desktop-color: "#000000"

terminal-box: "terminal_box_*.png"
terminal-font: "DejaVu Sans Mono 10"
terminal-border: 10
terminal-left: 10%
terminal-top: 35%
terminal-width: 80%
terminal-height: 40%

+ boot_menu {
    left = 10%
    top = 35%
    width = 80%
    height = 40%
    item_font = "DejaVu Sans 12"
    item_color = "#ffffff"
    selected_item_color = "#18a999"
    item_height = 24
    item_padding = 10
    item_spacing = 4
    scrollbar = true
    scrollbar_width = 8
    scrollbar_color = "#333333"
    scrollbar_thumb_color = "#18a999"
}

+ progress_bar {
    id = "__timeout__"
    left = 10%
    top = 85%
    width = 80%
    height = 8
    bg_color = "#333333"
    fg_color = "#18a999"
    border_color = "#000000"
    text = "@TIMEOUT_NOTIFICATION_LONG@"
    font = "DejaVu Sans 10"
    text_color = "#ffffff"
}
EOF

cat > /etc/default/grub.d/oxios-theme.cfg <<'EOF'
GRUB_THEME="/usr/share/grub/themes/oxios/theme.txt"
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=1920x1080
GRUB_GFXPAYLOAD_LINUX=keep
EOF

update-grub 2>/dev/null || true

echo "GRUB theme configured"