#
# Oxi OS Calamares Branding Configuration
---
componentName: oxios

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
    productName: Oxi OS
    shortProductName: Oxi OS
    version: development
    shortVersion: dev
    versionedName: Oxi OS
    shortVersionedName: Oxi OS
    bootloaderEntryName: Oxi OS
    productUrl: https://github.com/oxi-os/oxi-os
    supportUrl: https://github.com/oxi-os/oxi-os
    knownIssuesUrl: https://github.com/oxi-os/oxi-os/issues
    releaseNotesUrl: https://github.com/oxi-os/oxi-os
    donateUrl: https://github.com/oxi-os/oxi-os

images:
    productIcon: logo.png
    productLogo: logo.png
    productWelcome: logo.png

style:
    SidebarBackground: "#000000"
    SidebarText: "#ffffff"
    SidebarTextCurrent: "#ffffff"
    SidebarBackgroundCurrent: "#18a999"

slideshow: "show.qml"
slideshowAPI: 2

uploadServer:
    type: "none"
